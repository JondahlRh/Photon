# Cube centered at the origin, with outward-facing triangles.
mtllib cube.mtl
o Cube

v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1

# Front: +Z
usemtl Red
f 5 6 7
f 5 7 8

# Right: +X
usemtl Green
f 2 3 7
f 2 7 6

# Top: +Y
usemtl Blue
f 4 8 7
f 4 7 3

# Back: -Z
usemtl Yellow
f 1 4 3
f 1 3 2

# Left: -X
usemtl Magenta
f 1 5 8
f 1 8 4

# Bottom: -Y
usemtl Cyan
f 1 2 6
f 1 6 5