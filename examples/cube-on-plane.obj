# Cube standing on a ground plane, for checking lighting and shadows.
# Each face has its own normal, so the cube keeps sharp edges.
# The bottom face of the cube is left out because it would lie in the ground plane.
mtllib cube-on-plane.mtl

vn 1 0 0
vn -1 0 0
vn 0 1 0
vn 0 0 1
vn 0 0 -1

o Ground
v -5 -1 -5
v  5 -1 -5
v  5 -1  5
v -5 -1  5

usemtl Ground
f 1//3 4//3 3//3
f 1//3 3//3 2//3

o Cube
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1

usemtl Cube

# Front: +Z
f 9//4 10//4 11//4
f 9//4 11//4 12//4

# Right: +X
f 6//1 7//1 11//1
f 6//1 11//1 10//1

# Top: +Y
f 8//3 12//3 11//3
f 8//3 11//3 7//3

# Back: -Z
f 5//5 8//5 7//5
f 5//5 7//5 6//5

# Left: -X
f 5//2 9//2 12//2
f 5//2 12//2 8//2
