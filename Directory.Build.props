<Project>
  <!--
    Shared build settings for all projects in Project Photon.
    Enforces the style guide rules directly in the compiler.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- DoD: "compiles without warnings" -> warnings fail the build -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Analyze style rules from .editorconfig during build -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- XML docs for public APIs (missing docs = CS1591 warning) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Security: check all (incl. transitive) packages for known vulnerabilities -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- Reproducible restores (required for "dotnet restore locked-mode" in CI) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Test projects: no XML doc requirement -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Source projects: StyleCop checks that every element is documented,
    including private ones (project requirement). Only the documentation
    rules are enabled, see .editorconfig.
  -->
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.149-beta" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
